{% from "components/blog-card.njk" import blogCard %}

<header class="content-section content-section--header">
  <div class="section-eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Blog</div>
  <h1>Notes and notions</h1>
  <p class="section-intro">Notes on full stack development, agentic coding workflows, and making the web more accessible.</p>
</header>

<div class="content-section">
  <ol class="blog-list">
    {%- for post in collections.posts %}
    <li>{{ blogCard(post) }}</li>
    {%- endfor %}
  </ol>
</div>
