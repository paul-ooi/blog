<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title and title != "Paul Ooi" %}{{ title }} — {% endif %}Paul Ooi</title>
<meta name="description" content="{{ description | default('Full stack web developer specializing in agentic coding, accessible design, and modern web development.') }}">
<link rel="canonical" href="{{ page.url | htmlBaseUrl }}">
<link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">

{% if ('sitemap' in page.url or 'resume-markdown' in page.url) %}
<meta name="robots" content="noindex, nofollow">
{% endif %}

{# Preconnect to Google Fonts — eliminates one round trip #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400&family=General+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

{# Compiled SCSS output — webpack outputs to /dist/ #}
<link rel="stylesheet" href="/dist/main.css">
