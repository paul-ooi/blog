{#
  PROJECT CARD — Reusable card for project listings.

  Usage:
    {% from "components/project-card.njk" import projectCard %}
    {{ projectCard(project, icons) }}

  Expects a project object (from _data/projects.json) with:
    project.name, project.description, project.url, project.tags[]
  Optional icons object (from _data/icons.json) mapping tag names to icon filenames.

  Icons: When a tag matches a key in icons.json, the pill shows an icon
  with the tag name as a native tooltip via <abbr title>. Tags without
  icons display as plain text pills. Brand PNGs live in /assets/icons/.
#}
{% macro projectCard(project, icons) %}
<article class="project-item">
  <h3>
    {%- if project.url | isArray -%}
      {{ project.name }}
    {%- else -%}
      <a href="{{ project.url }}" rel="noopener noreferrer">{{ project.name }}</a>
    {%- endif -%}
  </h3>
  <p>{{ project.description }}</p>
  {%- if project.url | isArray %}
  <ul class="project-links">
    {% for url in project.url %}
    <li><a href="{{ url }}" rel="noopener noreferrer">{{ url }}</a></li>
    {% endfor %}
  </ul>
  {%- endif %}
  {% if project.tags | length %}
  <ul class="pill-list" aria-label="Technologies used in {{ project.name }}">
    {% for tag in project.tags %}
    <li>
      {%- if icons[tag] %}
      <abbr class="pill pill--icon-only" title="{{ tag }}">
        <img class="pill__icon" src="{{ ('/assets/icons/' ~ icons[tag]) | url }}" alt="{{ tag }}" width="16" height="16">
      </abbr>
      {%- else %}
      <span class="pill">{{ tag }}</span>
      {%- endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</article>
{% endmacro %}
