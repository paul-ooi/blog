{#
  SIDEBAR PARTIAL — The sticky left column on main pages.

  Contains:
  1. Logo with animated zigzag scribble (CSS animation, no JS)
  2. Site title + tagline
  3. Navigation with per-page SVG icons and hover animations
  4. Social links
  5. 3-state theme toggle (native radio fieldset)
#}
<header class="sidebar" role="banner">
  <div class="sidebar-top">

    {# ── Logo + Zigzag scribble ── #}
    <a href="/" class="site-logo" aria-label="Paul Ooi, home">
      <span class="site-logo__text">Paul Ooi</span>
      <svg class="site-logo__scribble" viewBox="0 0 120 12" aria-hidden="true" preserveAspectRatio="none">
        <path class="scribble-path"
          d="M2,8 L8,3 L14,8 L20,3 L26,8 L32,3 L38,8 L44,3 L50,8 L56,3 L62,8 L68,3 L74,8 L80,3 L86,8 L92,3 L98,8 L104,3 L110,8 L116,3" />
      </svg>
    </a>

    <p class="site-title">Full Stack Developer &amp; A11y Advocate</p>
    <p class="site-tagline">I build accessible software with agentic coding practices. The best code serves everyone.</p>

    {# ── Navigation ── #}
    <nav class="sidebar-nav" aria-label="Primary">
      <ul>
        {%- for item in navigation.items %}
        <li>
          <a href="{{ item.url }}" data-nav="{{ item.id }}"
            {% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %}
              aria-current="page"
            {% endif %}>
            <span class="nav-icon" aria-hidden="true">
              {% if item.id == "home" %}
              <svg viewBox="0 0 24 24"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V19a1 1 0 001 1h3v-5a1 1 0 011-1h4a1 1 0 011 1v5h3a1 1 0 001-1V9.5"/></svg>
              {% elif item.id == "projects" %}
              <svg viewBox="0 0 24 24"><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="9" width="8" height="12" rx="1"/><rect x="7" y="3" width="8" height="8" rx="1"/></svg>
              {% elif item.id == "blog" %}
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="7" y1="8" x2="17" y2="8"/><line x1="7" y1="12" x2="13" y2="12"/><line x1="7" y1="16" x2="15" y2="16"/></svg>
              {% elif item.id == "experience" %}
              <svg viewBox="0 0 24 24"><line x1="12" y1="3" x2="12" y2="21"/><path d="M6 6h10l2 2.5L16 11H6V6z"/><path d="M18 14H8l-2 2.5L8 19h10V14z"/></svg>
              {% elif item.id == "colophon" %}
              <svg viewBox="0 0 24 24"><path d="M5 15c0 3.5 3.1 6 7 6s7-2.5 7-6"/><path d="M3 15h18"/><line x1="15" y1="4" x2="9" y2="13"/><circle cx="15.5" cy="3.5" r="1.5"/></svg>
              {% endif %}
            </span>
            {{ item.text }}
            <span class="nav-indicator" aria-hidden="true"></span>
          </a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </div>

  <div class="sidebar-bottom">
    {# ── Social links ── #}
    <nav class="sidebar-social" aria-label="Social links">
      <a href="https://github.com/paul-ooi" class="social-link" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://linkedin.com/in/paulooi" class="social-link" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:paul@paulooi.ca" class="social-link" aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22,6 12,13 2,6"/></svg>
      </a>
      <a href="/feed.xml" class="social-link" aria-label="RSS Feed">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 11a9 9 0 019 9"/><path d="M4 4a16 16 0 0116 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
      </a>
    </nav>

    {# ── Theme toggle ── #}
    {% set compact = false %}
    {% include "partials/theme-toggle.njk" %}
  </div>
</header>
