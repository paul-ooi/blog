{#
  TOPBAR PARTIAL — Compact single-row header for blog post pages.

  Same nav as sidebar but compressed into one horizontal bar.
  No tagline or full social row — keeps the header lightweight.
#}
<header class="top-bar" role="banner">
  <div class="top-bar__inner">
    <div class="top-bar__left">
      <a href="/" class="site-logo site-logo--compact" aria-label="Paul Ooi, home">
        <span class="site-logo__text">Paul Ooi</span>
        <svg class="site-logo__scribble site-logo__scribble--compact" viewBox="0 0 80 10" aria-hidden="true" preserveAspectRatio="none">
          <path class="scribble-path" d="M2,7 L7,3 L12,7 L17,3 L22,7 L27,3 L32,7 L37,3 L42,7 L47,3 L52,7 L57,3 L62,7 L67,3 L72,7 L77,3" />
        </svg>
      </a>
      <nav class="top-nav" aria-label="Primary">
        <ul>
          {%- for item in navigation.items %}
          <li>
            <a href="{{ item.url }}"
              {% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %}
                aria-current="page"
              {% endif %}>{{ item.text }}</a>
          </li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
    <div class="top-bar__right">
      <a href="https://github.com/paul-ooi" class="social-link" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      {% set compact = true %}
      {% include "partials/theme-toggle.njk" %}
    </div>
  </div>
</header>
