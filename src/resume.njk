---
layout: sidebar-layout.njk
pageName: experience
title: Experience
description: Professional experience, education, and skills.
permalink: /experience/
---

{# ── Career ── #}
<header class="content-section content-section--header">
  <div class="section-eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Experience</div>
  <h1>Where I've worked</h1>
</header>

<section class="content-section" aria-labelledby="career-heading">
  <h2 id="career-heading">Career</h2>
  <ol class="experience-list">
    {%- for job in resume.jobs %}
    <li class="experience-item">
      <div class="experience-date">{{ job.date }}</div>
      <div>
        <h3>{{ job.name }}</h3>
        <p class="experience-role">{{ job.organization }}</p>
        {% if job.details %}
        <ul class="experience-details">
          {%- for detail in job.details %}
          <li>{{ detail | safe }}</li>
          {%- endfor %}
        </ul>
        {% endif %}
        {% if job.skills %}
        <ul class="pill-list" aria-label="Skills used at {{ job.name }}">
          {%- for skill in job.skills %}
          <li><span class="pill">{{ skill }}</span></li>
          {%- endfor %}
        </ul>
        {% endif %}
      </div>
    </li>
    {%- endfor %}
  </ol>
</section>

{# ── Education ── #}
<section class="content-section" aria-labelledby="education-heading">
  <h2 id="education-heading">Education &amp; Certifications</h2>
  <ol class="experience-list">
    {%- for item in resume.education %}
    <li class="experience-item">
      <div class="experience-date">{{ item.date }}</div>
      <div>
        <h3>{{ item.name }}</h3>
        <p class="experience-role">{{ item.organization }}</p>
      </div>
    </li>
    {%- endfor %}
  </ol>
</section>

{# ── Skills ── #}
<section class="content-section" aria-labelledby="skills-heading">
  <h2 id="skills-heading">Skills</h2>
  {%- for category, skillList in resume.skills %}
  <div class="experience-item">
    <div class="experience-date">{{ category }}</div>
    <div>
      <ul class="pill-list" aria-label="{{ category }}">
        {%- for skill in skillList %}
        <li><span class="pill">{{ skill }}</span></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
  {%- endfor %}
</section>
